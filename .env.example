# Shared SQLite/libSQL database
# Local dev: absolute file: URL pointing at data/app.db (resolved the same way from
# both the Python side (config.py's BASE_DIR) and the TS side, to avoid two processes
# creating separate database files from different working directories).
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Optional: Telegram end-of-day reports (packages/shared/src/telegram.ts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: private Polygon RPC override (see config.py PRIVATE_POLYGON_RPC_URL)
BULLPEN_POLYGON_RPC_URL=
