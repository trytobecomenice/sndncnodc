# Shared SQLite/libSQL database
# Local dev: absolute file: URL pointing at data/app.db (resolved the same way from
# both the Python side (config.py's BASE_DIR) and the TS side, to avoid two processes
# creating separate database files from different working directories).
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Optional: Telegram alerts (telegram_alerts.py, 2026-07-31 -- kill-switch
# triggers, throttled error alerts, daily PnL summary). Get a token from
# @BotFather on Telegram (/newbot), then message your new bot once and
# check https://api.telegram.org/bot<TOKEN>/getUpdates for your chat_id.
# Both silently no-op (bot.py keeps running normally) if left unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: private Polygon RPC override (see config.py PRIVATE_POLYGON_RPC_URL)
BULLPEN_POLYGON_RPC_URL=

# wss_listener.py (real-time on-chain trade detection, standalone process —
# see docs/copy-trading/SAFETY.md Rule 24). A Polygon mainnet WEBSOCKET
# endpoint -- Alchemy's Polygon Mainnet app gives one in the form
# wss://polygon-mainnet.g.alchemy.com/v2/<API_KEY>. Infura/QuickNode/your
# own node work identically; the var is provider-agnostic on purpose.
# Loaded via python-dotenv -- put the real value in a local, git-ignored
# .env (never commit it, never paste it into chat/logs).
POLYGON_WSS_URL=

# Optional: comma-separated wallet override for wss_listener.py. Leave
# unset to watch every wallet in config.TRACKED_TRADERS automatically.
WHALE_WALLET_ADDRESSES=
