{
  "name": "polymarket-copybot",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter dashboard dev",
    "db:generate": "pnpm --filter @copybot/db generate",
    "db:migrate": "pnpm --filter @copybot/db migrate",
    "db:studio": "pnpm --filter @copybot/db studio",
    "seed": "pnpm --filter @copybot/db seed",
    "scan:leaderboard": "pnpm --filter @copybot/copy-trading scan:leaderboard",
    "scan:wallets": "pnpm --filter @copybot/copy-trading scan:wallets",
    "score:wallet-categories": "pnpm --filter @copybot/copy-trading score:wallet-categories",
    "discover:category-specialists": "pnpm --filter @copybot/copy-trading discover:category-specialists",
    "monitor:trades": "pnpm --filter @copybot/copy-trading monitor:trades",
    "score:trades": "pnpm --filter @copybot/copy-trading score:trades",
    "paper:update-pnl": "pnpm --filter @copybot/copy-trading paper:update-pnl",
    "review:outcomes": "pnpm --filter @copybot/copy-trading review:outcomes",
    "update:rules": "pnpm --filter @copybot/copy-trading update:rules",
    "report:daily": "pnpm --filter @copybot/copy-trading report:daily",
    "reconcile:position-tracker": "pnpm --filter @copybot/copy-trading reconcile:position-tracker",
    "research:wallets-daily": "bash scripts/run_daily_wallet_research.sh",
    "canary:bullpen-execution": "python3 bullpen_execution_canary.py",
    "test": "pnpm -r test"
  }
}
